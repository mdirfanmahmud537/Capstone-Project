void depositMoney(void) {
    clearScreen();
    header("DEPOSIT MONEY");

    int acc;
    if (strcmp(current_user.role, ROLE_CUSTOMER) == 0)
        acc = customers[current_customer_index].acc_no;
    else
        acc = getInt("  Account Number: ");

    int idx = findCustomer(acc);
    if (idx == -1) {
        printf("  Active account not found!\n");
        pressEnter();
        return;
    }

    printf("\n  Customer: %s\n", customers[idx].name);
    printf("  Current Balance: $%.2f\n", customers[idx].balance);

    double amount = getDouble("  Amount to deposit: ");
    if (amount <= 0) {
        printf("  Amount must be positive!\n");
        pressEnter();
        return;
    }

    customers[idx].balance += amount;
    addTransaction(acc, "Deposit", amount, customers[idx].balance, 0);
    saveData();
    logAction("Deposited money");

    printf("\n  Deposit successful!\n");
    printf("  New Balance: $%.2f\n", customers[idx].balance);
    pressEnter();
}

void withdrawMoney(void) {
    clearScreen();
    header("WITHDRAW MONEY");

    int acc;
    if (strcmp(current_user.role, ROLE_CUSTOMER) == 0)
        acc = customers[current_customer_index].acc_no;
    else
        acc = getInt("  Account Number: ");

    int idx = findCustomer(acc);
    if (idx == -1) {
        printf("  Active account not found!\n");
        pressEnter();
        return;
    }

    printf("\n  Customer: %s\n", customers[idx].name);
    printf("  Balance: $%.2f\n", customers[idx].balance);

    if (strcmp(current_user.role, ROLE_CUSTOMER) != 0) {
        char pin[8];
        readInput("  Customer PIN: ", pin, sizeof(pin));
        if (strcmp(pin, customers[idx].pin) != 0) {
            printf("  Incorrect PIN!\n");
            logAction("Failed withdrawal PIN validation");
            pressEnter();
            return;
        }
    }

    double amount = getDouble("  Amount to withdraw: ");
    if (amount <= 0) {
        printf("  Amount must be positive!\n");
        pressEnter();
        return;
    }
    if (amount > customers[idx].balance) {
        printf("  Insufficient balance!\n");
        pressEnter();
        return;
    }

    customers[idx].balance -= amount;
    addTransaction(acc, "Withdraw", amount, customers[idx].balance, 0);
    saveData();
    logAction("Withdrew money");

    printf("\n  Withdrawal successful!\n");
    printf("  New Balance: $%.2f\n", customers[idx].balance);
    if (customers[idx].balance < LOW_BALANCE_LIMIT)
        printf("  WARNING: Low balance alert triggered!\n");
    pressEnter();
}

void transferMoney(void) {
    clearScreen();
    header("TRANSFER FUNDS");

    int from_acc;
    if (strcmp(current_user.role, ROLE_CUSTOMER) == 0)
        from_acc = customers[current_customer_index].acc_no;
    else
        from_acc = getInt("  From Account: ");

    int from_idx = findCustomer(from_acc);
    if (from_idx == -1) {
        printf("  Source account not found!\n");
        pressEnter();
        return;
    }

    printf("\n  Sender: %s\n", customers[from_idx].name);
    printf("  Balance: $%.2f\n", customers[from_idx].balance);

    if (strcmp(current_user.role, ROLE_CUSTOMER) != 0) {
        char pin[8];
        readInput("  Sender PIN: ", pin, sizeof(pin));
        if (strcmp(pin, customers[from_idx].pin) != 0) {
            printf("  Incorrect PIN!\n");
            logAction("Failed transfer PIN validation");
            pressEnter();
            return;
        }
    }

    int to_acc = getInt("  To Account: ");
    if (to_acc == from_acc) {
        printf("  Cannot transfer to the same account!\n");
        pressEnter();
        return;
    }

    int to_idx = findCustomer(to_acc);
    if (to_idx == -1) {
        printf("  Destination account not found!\n");
        pressEnter();
        return;
    }

    double amount = getDouble("  Amount: ");
    if (amount <= 0) {
        printf("  Amount must be positive!\n");
        pressEnter();
        return;
    }
    if (amount > customers[from_idx].balance) {
        printf("  Insufficient balance!\n");
        pressEnter();
        return;
    }

    customers[from_idx].balance -= amount;
    customers[to_idx].balance += amount;

    addTransaction(from_acc, "Transfer-Out", amount, customers[from_idx].balance, to_acc);
    addTransaction(to_acc, "Transfer-In", amount, customers[to_idx].balance, from_acc);
    saveData();
    logAction("Transferred funds");

    printf("\n  Transfer successful!\n");
    printf("  From: %d\n", from_acc);
    printf("  To:   %d\n", to_acc);
    printf("  Amount: $%.2f\n", amount);
    printf("  Sender New Balance: $%.2f\n", customers[from_idx].balance);
    pressEnter();
}

