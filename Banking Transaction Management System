int findCustomer(int acc_no) {
    for (int i = 0; i < cust_count; i++)
        if (customers[i].acc_no == acc_no && customers[i].active) return i;
    return -1;
}

int findCustomerAny(int acc_no) {
    for (int i = 0; i < cust_count; i++)
        if (customers[i].acc_no == acc_no) return i;
    return -1;
}

int findCustomerByName(const char *name) {
    for (int i = 0; i < cust_count; i++)
        if (strcmp(customers[i].name, name) == 0) return i;
    return -1;
}

int findStaffByUsername(const char *username) {
    for (int i = 0; i < staff_count; i++)
        if (strcmp(staffList[i].username, username) == 0) return i;
    return -1;
}

int generateAccNo(void) {
    int max = START_ACC_NO - 1;
    for (int i = 0; i < cust_count; i++)
        if (customers[i].acc_no > max) max = customers[i].acc_no;
    return max + 1;
}

