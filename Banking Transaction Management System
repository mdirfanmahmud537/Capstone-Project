void createAccount(void) {
    clearScreen();
    header("CREATE CUSTOMER ACCOUNT");

    if (cust_count >= MAX_CUSTOMERS) {
        printf("  Customer database is full!\n");
        pressEnter();
        return;
    }

    Customer c;
    memset(&c, 0, sizeof(c));
    c.acc_no = generateAccNo();
    c.active = true;

    do {
        readInput("  Full Name: ", c.name, sizeof(c.name));
        if (isBlank(c.name)) printf("  Name cannot be empty.\n");
    } while (isBlank(c.name));

    readInput("  Phone: ", c.phone, sizeof(c.phone));
    readInput("  Address: ", c.address, sizeof(c.address));

    do {
        readInput("  Account Type (savings/current): ", c.acc_type, sizeof(c.acc_type));
        for (int i = 0; c.acc_type[i]; i++) c.acc_type[i] = (char)tolower((unsigned char)c.acc_type[i]);
        if (strcmp(c.acc_type, "savings") != 0 && strcmp(c.acc_type, "current") != 0)
            printf("  Please enter savings or current.\n");
    } while (strcmp(c.acc_type, "savings") != 0 && strcmp(c.acc_type, "current") != 0);

    do {
        readInput("  4-digit PIN: ", c.pin, sizeof(c.pin));
        bool valid = strlen(c.pin) == 4;
        for (int i = 0; c.pin[i] && valid; i++)
            if (!isdigit((unsigned char)c.pin[i])) valid = false;
        if (!valid) printf("  PIN must contain exactly 4 digits.\n");
        if (valid) break;
    } while (1);

    do {
        c.balance = getDouble("  Initial Deposit: ");
        if (c.balance < 0) printf("  Initial deposit cannot be negative.\n");
    } while (c.balance < 0);

    getTime(c.created, sizeof(c.created));
    customers[cust_count++] = c;

    if (c.balance > 0)
        addTransaction(c.acc_no, "Deposit", c.balance, c.balance, 0);

    saveData();
    logAction("Created customer account");

    printf("\n  Account created successfully!\n");
    printf("  Account Number: %d\n", c.acc_no);
    printf("  Balance: $%.2f\n", c.balance);
    pressEnter();
}

void viewAccounts(void) {
    clearScreen();
    header("ALL CUSTOMER ACCOUNTS");

    if (cust_count == 0) {
        printf("  No accounts found.\n");
        pressEnter();
        return;
    }

    printf("\n  %-5s %-8s %-22s %-10s %-12s %-9s\n",
           "No.", "Acc No", "Name", "Type", "Balance", "Status");
    printf("  -----------------------------------------------------------------------\n");

    for (int i = 0; i < cust_count; i++) {
        printf("  %-5d %-8d %-22.22s %-10s $%-11.2f %-9s\n",
               i + 1, customers[i].acc_no, customers[i].name,
               customers[i].acc_type, customers[i].balance,
               customers[i].active ? "ACTIVE" : "CLOSED");
    }
    pressEnter();
}

void searchAccount(void) {
    clearScreen();
    header("SEARCH ACCOUNT");

    printf("  1. Search by Account Number\n");
    printf("  2. Search by Customer Name\n");
    int choice = getInt("\n  Choice: ");

    if (choice == 1) {
        int acc = getInt("  Account Number: ");
        int idx = findCustomerAny(acc);
        if (idx == -1) printf("\n  Account not found!\n");
        else showCustomer(idx);
    } else if (choice == 2) {
        char name[MAX_STR];
        readInput("  Customer Name (or part): ", name, sizeof(name));
        bool found = false;
        for (int i = 0; i < cust_count; i++) {
            char a[MAX_STR], b[MAX_STR];
            copyString(a, customers[i].name, sizeof(a));
            copyString(b, name, sizeof(b));
            for (int j = 0; a[j]; j++) a[j] = (char)tolower((unsigned char)a[j]);
            for (int j = 0; b[j]; j++) b[j] = (char)tolower((unsigned char)b[j]);
            if (strstr(a, b)) {
                showCustomer(i);
                found = true;
            }
        }
        if (!found) printf("\n  No matching customer found!\n");
    } else {
        printf("\n  Invalid choice!\n");
    }

    pressEnter();
}

void updateAccount(void) {
    clearScreen();
    header("UPDATE CUSTOMER ACCOUNT");

    int acc = getInt("  Account Number: ");
    int idx = findCustomerAny(acc);

    if (idx == -1) {
        printf("  Account not found!\n");
        pressEnter();
        return;
    }

    Customer *c = &customers[idx];
    printf("\n  Updating: %s\n", c->name);
    readInput("  New Name (Enter to keep current): ", c->name, sizeof(c->name));
    readInput("  New Phone (Enter to keep current): ", c->phone, sizeof(c->phone));
    readInput("  New Address (Enter to keep current): ", c->address, sizeof(c->address));

    saveData();
    logAction("Updated customer account");
    printf("\n  Account updated successfully!\n");
    pressEnter();
}

void deleteAccount(void) {
    clearScreen();
    header("DELETE ACCOUNT");

    int acc = getInt("  Account Number: ");
    int idx = findCustomerAny(acc);

    if (idx == -1) {
        printf("  Account not found!\n");
        pressEnter();
        return;
    }

    printf("\n  Account: %s\n", customers[idx].name);
    printf("  Balance: $%.2f\n", customers[idx].balance);

    if (customers[idx].balance != 0) {
        printf("  Account must have zero balance before deletion.\n");
        pressEnter();
        return;
    }

    if (!confirm("  Permanently delete this account? (y/n): ")) {
        printf("  Cancelled.\n");
        pressEnter();
        return;
    }

    for (int i = idx; i < cust_count - 1; i++)
        customers[i] = customers[i + 1];
    cust_count--;

    saveData();
    logAction("Deleted customer account");
    printf("\n  Account deleted successfully!\n");
    pressEnter();
}

void viewBalance(void) {
    clearScreen();
    header("VIEW BALANCE");

    int idx;
    if (strcmp(current_user.role, ROLE_CUSTOMER) == 0) {
        idx = current_customer_index;
    } else {
        int acc = getInt("  Account Number: ");
        idx = findCustomerAny(acc);
    }

    if (idx < 0 || idx >= cust_count || !customers[idx].active) {
        printf("\n  Active account not found!\n");
    } else {
        printf("\n  Customer: %s\n", customers[idx].name);
        printf("  Account: %d\n", customers[idx].acc_no);
        printf("  Current Balance: $%.2f\n", customers[idx].balance);
        if (customers[idx].balance < LOW_BALANCE_LIMIT)
            printf("  WARNING: Balance is below $%.2f\n", LOW_BALANCE_LIMIT);
    }
    pressEnter();
}

void accountStatement(void) {
    clearScreen();
    header("ACCOUNT STATEMENT");

    int acc;
    if (strcmp(current_user.role, ROLE_CUSTOMER) == 0)
        acc = customers[current_customer_index].acc_no;
    else
        acc = getInt("  Account Number: ");

    int idx = findCustomerAny(acc);
    if (idx == -1) {
        printf("  Account not found!\n");
        pressEnter();
        return;
    }

    printf("\n  Account Statement\n");
    printf("  Customer : %s\n", customers[idx].name);
    printf("  Account  : %d\n", customers[idx].acc_no);
    printf("  Type     : %s\n", customers[idx].acc_type);
    printf("  Balance  : $%.2f\n", customers[idx].balance);
    printf("  Created  : %s\n\n", customers[idx].created);
    printf("  %-5s %-20s %-12s %-14s %-10s\n", "ID", "Date", "Type", "Amount", "Balance");
    printf("  ----------------------------------------------------------------\n");

    int found = 0;
    for (int i = 0; i < trans_count; i++) {
        if (transactions[i].acc_no == acc) {
            printf("  %-5d %-20s %-12s $%-13.2f $%-10.2f\n",
                   transactions[i].id, transactions[i].date, transactions[i].type,
                   transactions[i].amount, transactions[i].balance_after);
            found++;
        }
    }
    if (!found) printf("  No transaction records found.\n");
    pressEnter();
}

void sortAccounts(void) {
    clearScreen();
    header("SORT ACCOUNTS");

    if (cust_count < 2) {
        printf("  Not enough accounts to sort.\n");
        pressEnter();
        return;
    }

    printf("  1. Sort by Account Number\n");
    printf("  2. Sort by Balance\n");
    int choice = getInt("\n  Choice: ");

    if (choice == 1)
        qsort(customers, cust_count, sizeof(Customer), compareAccNo);
    else if (choice == 2)
        qsort(customers, cust_count, sizeof(Customer), compareBalance);
    else {
        printf("  Invalid choice!\n");
        pressEnter();
        return;
    }

    saveData();
    logAction("Sorted customer accounts");
    printf("\n  Accounts sorted successfully.\n\n");
    for (int i = 0; i < cust_count; i++)
        printf("  %-8d %-22.22s $%.2f\n", customers[i].acc_no, customers[i].name, customers[i].balance);
    pressEnter();
}

void lowBalanceAlert(void) {
    clearScreen();
    header("LOW BALANCE ALERT");

    int found = 0;
    printf("  Threshold: $%.2f\n\n", LOW_BALANCE_LIMIT);
    printf("  %-8s %-22s %-14s\n", "Acc No", "Customer", "Balance");
    printf("  ------------------------------------------------\n");

    for (int i = 0; i < cust_count; i++) {
        if (customers[i].active && customers[i].balance < LOW_BALANCE_LIMIT) {
            printf("  %-8d %-22.22s $%-13.2f\n",
                   customers[i].acc_no, customers[i].name, customers[i].balance);
            found++;
        }
    }

    if (!found) printf("  No account is below the low-balance threshold.\n");
    else logAction("Viewed low balance alerts");
    pressEnter();
}

