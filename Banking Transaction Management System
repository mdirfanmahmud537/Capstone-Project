void backupData(void) {
    clearScreen();
    header("BACKUP DATA");

    const char *src[] = { CUSTOMER_FILE, TRANSACTION_FILE, STAFF_FILE, LOG_FILE };
    const char *dst[] = { BACKUP_CUSTOMER, BACKUP_TRANS, BACKUP_STAFF, BACKUP_LOG };
    int ok = 0;

    saveData();

    for (int i = 0; i < 4; i++) {
        FILE *in = fopen(src[i], "rb");
        FILE *out = fopen(dst[i], "wb");
        if (!in || !out) {
            if (in) fclose(in);
            if (out) fclose(out);
            continue;
        }
        int ch;
        while ((ch = fgetc(in)) != EOF) fputc(ch, out);
        fclose(in);
        fclose(out);
        ok++;
    }

    if (ok == 4) {
        logAction("Created full data backup");
        printf("  Backup completed successfully.\n");
    } else {
        printf("  Backup partially completed (%d/4 files).\n", ok);
    }
    pressEnter();
}

void restoreData(void) {
    clearScreen();
    header("RESTORE DATA");

    if (!confirm("  Restore all data from backup? (y/n): ")) {
        printf("  Restore cancelled.\n");
        pressEnter();
        return;
    }

    const char *src[] = { BACKUP_CUSTOMER, BACKUP_TRANS, BACKUP_STAFF, BACKUP_LOG };
    const char *dst[] = { CUSTOMER_FILE, TRANSACTION_FILE, STAFF_FILE, LOG_FILE };
    int ok = 0;

    for (int i = 0; i < 4; i++) {
        FILE *in = fopen(src[i], "rb");
        FILE *out = fopen(dst[i], "wb");
        if (!in || !out) {
            if (in) fclose(in);
            if (out) fclose(out);
            continue;
        }
        int ch;
        while ((ch = fgetc(in)) != EOF) fputc(ch, out);
        fclose(in);
        fclose(out);
        ok++;
    }

    if (ok == 4) {
        loadData();
        logAction("Restored full data backup");
        printf("  Data restored successfully.\n");
    } else {
        printf("  Restore failed or is incomplete (%d/4 files).\n", ok);
    }
    pressEnter();
}

void logAction(const char *action) {
    FILE *f = fopen(LOG_FILE, "a");
