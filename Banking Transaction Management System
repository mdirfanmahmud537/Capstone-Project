void createStaff(void) {
    clearScreen();
    header("CREATE STAFF / ADMIN USER");

    if (staff_count >= MAX_STAFF) {
        printf("  Staff limit reached!\n");
        pressEnter();
        return;
    }

    Staff s;
    memset(&s, 0, sizeof(s));
    s.id = staff_count + 1;
    s.active = true;

    readInput("  Full Name: ", s.fullname, sizeof(s.fullname));

    while (1) {
        readInput("  Username: ", s.username, sizeof(s.username));
        if (findStaffByUsername(s.username) == -1) break;
        printf("  Username already exists!\n");
    }

    readInput("  Password: ", s.password, sizeof(s.password));
    printf("  1. Staff\n");
    printf("  2. Admin\n");
    int role_choice = getInt("  Role: ");
    copyString(s.role, role_choice == 2 ? ROLE_ADMIN : ROLE_STAFF, sizeof(s.role));

    staffList[staff_count++] = s;
    saveData();
    logAction("Created staff/admin user");

    printf("\n  User created: %s\n", s.username);
    pressEnter();
}

