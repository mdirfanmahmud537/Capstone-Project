int main(void) {
    loadData();
    initAdmin();

    while (1) {
        clearScreen();
        header("BANKING TRANSACTION MANAGEMENT SYSTEM");
        printf("  1. Staff/Admin Login\n");
        printf("  2. Customer Login\n");
        printf("  3. Exit\n");

        int choice = getInt("\n  Enter choice: ");

        if (choice == 1) {
            if (staffLogin()) {
                if (strcmp(current_user.role, ROLE_ADMIN) == 0)
                    adminMenu();
                else
                    staffMenu();
                logout();
            }
        } else if (choice == 2) {
            if (customerLogin()) {
                customerMenu();
                logout();
            }
        } else if (choice == 3) {
            saveData();
            printf("\n  Thank you for using the Banking System!\n");
            break;
        } else {
            printf("\n  Invalid choice!\n");
            pressEnter();
        }
    }

    return 0;
}

/* ================================================================ */
/* AUTHENTICATION                                                   */
/* ================================================================ */
bool staffLogin(void) {
    clearScreen();
    header("STAFF / ADMIN LOGIN");

    char uname[MAX_STR], pass[MAX_STR];
    readInput("  Username: ", uname, sizeof(uname));
    readInput("  Password: ", pass, sizeof(pass));

    for (int i = 0; i < staff_count; i++) {
        if (strcmp(staffList[i].username, uname) == 0 &&
            strcmp(staffList[i].password, pass) == 0) {

            if (!staffList[i].active) {
                printf("\n  Account disabled! Contact administrator.\n");
                pressEnter();
                return false;
            }

            current_user = staffList[i];
            logged_in = true;
            current_customer_index = -1;
            logAction("User logged in");
            printf("\n  Welcome, %s!\n", current_user.fullname);
            pressEnter();
            return true;
        }
    }

    printf("\n  Invalid credentials!\n");
    pressEnter();
    return false;
}

bool customerLogin(void) {
    clearScreen();
    header("CUSTOMER LOGIN");

    int acc = getInt("  Account Number: ");
    int idx = findCustomer(acc);

    if (idx == -1) {
        printf("\n  Active account not found!\n");
        pressEnter();
        return false;
    }

    char pin[8];
    readInput("  4-digit PIN: ", pin, sizeof(pin));

    if (strcmp(pin, customers[idx].pin) != 0) {
        printf("\n  Incorrect PIN!\n");
        logAction("Failed customer login attempt");
        pressEnter();
        return false;
    }

    memset(&current_user, 0, sizeof(current_user));
    copyString(current_user.fullname, customers[idx].name, sizeof(current_user.fullname));
    copyString(current_user.role, ROLE_CUSTOMER, sizeof(current_user.role));
    logged_in = true;
    current_customer_index = idx;
    logAction("Customer logged in");

    printf("\n  Welcome, %s!\n", customers[idx].name);
    pressEnter();
    return true;
}

void logout(void) {
    if (logged_in) logAction("User logged out");
    memset(&current_user, 0, sizeof(current_user));
    logged_in = false;
    current_customer_index = -1;
}

