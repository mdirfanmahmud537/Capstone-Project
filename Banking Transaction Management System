/* ================================================================ */
/* INPUT / UTILITY                                                  */
/* ================================================================ */
void clearScreen(void) {
#ifdef _WIN32
    system("cls");
#else
    system("clear");
#endif
}

void header(const char *title) {
    printf("==============================================================\n");
    printf("  %s\n", title);
    printf("==============================================================\n");
}

void pressEnter(void) {
    char buf[8];
    printf("\n  Press Enter to continue...");
    fgets(buf, sizeof(buf), stdin);
}

void getTime(char *buffer, size_t size) {
    time_t t = time(NULL);
    struct tm *tm_info = localtime(&t);
    if (tm_info) strftime(buffer, size, "%Y-%m-%d %H:%M:%S", tm_info);
    else if (size > 0) buffer[0] = '\0';
}

void readInput(const char *prompt, char *buffer, int size) {
    printf("%s", prompt);
    if (fgets(buffer, size, stdin) == NULL) {
        saveData();
        exit(0);
    }

    if (strchr(buffer, '\n') == NULL) {
        int ch;
        while ((ch = getchar()) != '\n' && ch != EOF) {}
    }

    buffer[strcspn(buffer, "\n")] = '\0';
    sanitizeField(buffer);
}

int getInt(const char *prompt) {
    char buf[64];
    int val;
    char extra;

    while (1) {
        readInput(prompt, buf, sizeof(buf));
        if (sscanf(buf, "%d %c", &val, &extra) == 1) return val;
        printf("  Enter a valid integer!\n");
    }
}

double getDouble(const char *prompt) {
    char buf[64];
    double val;
    char extra;

    while (1) {
        readInput(prompt, buf, sizeof(buf));
        if (sscanf(buf, "%lf %c", &val, &extra) == 1) return val;
        printf("  Enter a valid amount!\n");
    }
}

bool confirm(const char *prompt) {
    char buf[16];
    readInput(prompt, buf, sizeof(buf));
    return buf[0] == 'y' || buf[0] == 'Y';
}

void sanitizeField(char *s) {
    /* '|' is the record separator in the text files. */
    for (int i = 0; s[i]; i++)
        if (s[i] == '|') s[i] = '/';
}

void copyString(char *dest, const char *src, size_t size) {
    if (size == 0) return;
    strncpy(dest, src, size - 1);
    dest[size - 1] = '\0';
}

void trimSpaces(char *s) {
    char *start = s;
    while (isspace((unsigned char)*start)) start++;
    if (start != s) memmove(s, start, strlen(start) + 1);
    size_t n = strlen(s);
    while (n > 0 && isspace((unsigned char)s[n - 1])) s[--n] = '\0';
}

bool isBlank(const char *s) {
    while (*s) {
        if (!isspace((unsigned char)*s)) return false;
        s++;
    }
    return true;
}
