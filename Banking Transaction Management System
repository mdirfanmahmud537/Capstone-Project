void loadCustomers(void) {
    FILE *f = fopen(CUSTOMER_FILE, "r");
    if (!f) return;

    char line[600];
    if (!fgets(line, sizeof(line), f)) { fclose(f); return; }
    cust_count = atoi(line);
    if (cust_count < 0 || cust_count > MAX_CUSTOMERS) cust_count = 0;

    for (int i = 0; i < cust_count; i++) {
        if (!fgets(line, sizeof(line), f)) { cust_count = i; break; }
        Customer *c = &customers[i];
        memset(c, 0, sizeof(*c));
        char *tok = strtok(line, "|\n");
        if (!tok) { cust_count = i; break; } c->acc_no = atoi(tok);
        tok = strtok(NULL, "|\n"); if (tok) copyString(c->name, tok, sizeof(c->name));
        tok = strtok(NULL, "|\n"); if (tok) copyString(c->phone, tok, sizeof(c->phone));
        tok = strtok(NULL, "|\n"); if (tok) copyString(c->address, tok, sizeof(c->address));
        tok = strtok(NULL, "|\n"); if (tok) copyString(c->acc_type, tok, sizeof(c->acc_type));
        tok = strtok(NULL, "|\n"); if (tok) copyString(c->pin, tok, sizeof(c->pin));
        tok = strtok(NULL, "|\n"); if (tok) c->balance = atof(tok);
        tok = strtok(NULL, "|\n"); if (tok) c->active = atoi(tok) != 0;
        tok = strtok(NULL, "|\n"); if (tok) copyString(c->created, tok, sizeof(c->created));
    }
    fclose(f);
}

