int compareAccNo(const void *a, const void *b) {
    const Customer *x = (const Customer *)a;
    const Customer *y = (const Customer *)b;
    return (x->acc_no > y->acc_no) - (x->acc_no < y->acc_no);
}

int compareBalance(const void *a, const void *b) {
    const Customer *x = (const Customer *)a;
    const Customer *y = (const Customer *)b;
    if (x->balance < y->balance) return -1;
    if (x->balance > y->balance) return 1;
    return 0;
}

