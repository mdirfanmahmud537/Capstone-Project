void generateReports(void) {
    clearScreen();
    header("GENERATE BANKING REPORT");

    FILE *f = fopen(REPORT_FILE, "w");
    if (!f) {
        printf("  Could not create report file!\n");
        pressEnter();
        return;
    }

    double totalBalance = 0.0;
    double totalDeposits = 0.0;
    double totalWithdrawals = 0.0;
    double totalTransfers = 0.0;
    int active = 0, closed = 0;

    for (int i = 0; i < cust_count; i++) {
        totalBalance += customers[i].balance;
        if (customers[i].active) active++; else closed++;
    }

    for (int i = 0; i < trans_count; i++) {
        if (strcmp(transactions[i].type, "Deposit") == 0) totalDeposits += transactions[i].amount;
        else if (strcmp(transactions[i].type, "Withdraw") == 0) totalWithdrawals += transactions[i].amount;
        else if (strcmp(transactions[i].type, "Transfer-Out") == 0) totalTransfers += transactions[i].amount;
    }

    fprintf(f, "BANKING TRANSACTION MANAGEMENT SYSTEM\n");
    fprintf(f, "=====================================\n");
    fprintf(f, "Generated: ");
    char now[30]; getTime(now, sizeof(now));
    fprintf(f, "%s\n\n", now);
    fprintf(f, "Total Customers: %d\n", cust_count);
    fprintf(f, "Active Accounts: %d\n", active);
    fprintf(f, "Closed Accounts: %d\n", closed);
    fprintf(f, "Total Current Balance: %.2f\n", totalBalance);
    fprintf(f, "Total Deposit Transactions: %.2f\n", totalDeposits);
    fprintf(f, "Total Withdrawal Transactions: %.2f\n", totalWithdrawals);
    fprintf(f, "Total Transfer-Out Value: %.2f\n", totalTransfers);
    fprintf(f, "Total Transaction Records: %d\n", trans_count);
    fprintf(f, "\nACCOUNT SUMMARY\n");
    fprintf(f, "AccNo|Name|Type|Balance|Status\n");

    for (int i = 0; i < cust_count; i++) {
        fprintf(f, "%d|%s|%s|%.2f|%s\n",
                customers[i].acc_no, customers[i].name, customers[i].acc_type,
                customers[i].balance, customers[i].active ? "ACTIVE" : "CLOSED");
    }

    fclose(f);
    logAction("Generated banking report");

    printf("  Report generated successfully.\n");
    printf("  File: %s\n", REPORT_FILE);
    printf("  Total customers: %d\n", cust_count);
    printf("  Active accounts: %d\n", active);
    printf("  Total balance: $%.2f\n", totalBalance);
    pressEnter();
}

void addTransaction(int acc_no, const char *type, double amount,
                    double balance, int related) {
    if (trans_count >= MAX_TRANSACTIONS) return;

    Transaction t;
    memset(&t, 0, sizeof(t));
    t.id = trans_count + 1;
    t.acc_no = acc_no;
    copyString(t.type, type, sizeof(t.type));
    t.amount = amount;
    t.balance_after = balance;
    t.related_acc = related;
    getTime(t.date, sizeof(t.date));

    transactions[trans_count++] = t;
}

