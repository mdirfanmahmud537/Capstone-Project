void changePassword(void) {
    clearScreen();
    header("CHANGE PASSWORD");

    char old[MAX_STR], newp[MAX_STR], confirmp[MAX_STR];
    readInput("  Current Password: ", old, sizeof(old));

    if (strcmp(old, current_user.password) != 0) {
        printf("  Incorrect password!\n");
        pressEnter();
        return;
    }

    readInput("  New Password: ", newp, sizeof(newp));
    readInput("  Confirm Password: ", confirmp, sizeof(confirmp));

    if (strcmp(newp, confirmp) != 0) {
        printf("  Passwords do not match!\n");
        pressEnter();
        return;
    }

    if (strcmp(current_user.role, ROLE_CUSTOMER) == 0) {
        printf("  Customer PIN changes are not available in this version.\n");
        pressEnter();
        return;
    }

    for (int i = 0; i < staff_count; i++) {
        if (strcmp(staffList[i].username, current_user.username) == 0) {
            copyString(staffList[i].password, newp, sizeof(staffList[i].password));
            copyString(current_user.password, newp, sizeof(current_user.password));
            break;
        }
    }

    saveData();
    logAction("Changed password");
    printf("\n  Password changed successfully!\n");
    pressEnter();
}

